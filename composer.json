{
    "name": "jikan-me/jikan",
    "description": "Jikan is an unofficial MyAnimeList API",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Nekomata",
            "email": "neko@jikan.moe"
        }
    ],
    "autoload": {
        "psr-4": {
            "Jikan\\": [
                "src"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
          "JikanTest\\": [
              "test/unit"
          ]
        }
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "doctrine/collections": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.8",
        "jikan-me/jikan-fixtures": "dev-master",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpro/grumphp": "^2",
        "squizlabs/php_codesniffer": "^3.3"
    },
    "scripts": {
        "test": "phpunit",
        "csfixer-check": "php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@csfixer-check",
            "@endpoints:check",
            "@test"
        ],
        "endpoints:check": "php scripts/generate_endpoints.php --check",
        "endpoints:write": "php scripts/generate_endpoints.php --write",
        "link-fixtures": [
            "git clone https://github.com/jikan-me/jikan-fixtures.git ../jikan-fixtures || git -C ../jikan-fixtures reset --hard origin/master",
            "rm -rf vendor/jikan-me/jikan-fixtures",
            "composer config repositories.fixtures path ../jikan-fixtures",
            "composer update jikan-me/jikan-fixtures",
            "composer config repositories.fixtures --unset"
        ],
        "generate-docs": [
            "composer install --working-dir=tools/phpdoc --no-interaction",
            "git clone https://github.com/jikan-me/jikan-docs.git ../jikan-docs || git -C ../jikan-docs reset --hard origin/master",
            "\"$(pwd)/tools/phpdoc/vendor/bin/phpdoc\" run -d \"$(pwd)/src\" -t \"$(pwd)/../jikan-docs/docs\" --no-interaction"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "repositories": {
    }
}
