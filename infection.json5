{
    // Mutation testing: Infection makes small deliberate changes to the code ("mutants": flip a condition,
    // drop a line, return early) and runs the tests against each one. A mutant the tests do not notice
    // ("escaped") marks code that runs in tests but is not really checked by them.
    //
    // Runs in CI (.github/workflows/mutation.yaml): changed lines on pull requests, everything nightly.
    // "minMsi" fails the run when the score drops below it: one point under the last full run on master
    // (86% on 2026-10-14, 89% after the escaped-mutant tests in #651). Raise it as escaped mutants get covered.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src/Parser",
            "src/Helper"
        ]
    },
    "timeout": 30,
    "minMsi": 88,
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log",
        "html": "build/infection/infection.html"
    },
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "phpUnit": {
        "customPath": "vendor/phpunit/phpunit/phpunit"
    }
}
